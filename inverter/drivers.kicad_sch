	(text "FLT_MCU pini error triger olarak MCU'ya gidecek. \nBöylece Donanımsal Driver Protection olacak"
		(exclude_from_sim no)
		(at 200.66 69.85 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "40a07850-3108-48ef-ac8c-2d7c57fc6c08")
	)
	(text_box "UCC217 Datasheet-> Turn-On and Turn-Off Gate Resistors altında hesaplar mevcut\n\nR_OH_EFF = 0.7 Ω (driver pull-up, switching transient)\nR_OL     = 0.3 Ω (driver pull-down)\nR_G_int  = 6 Ω   (C3M0120065J internal)\nΔV       = VDD - VEE = 20V\n\n\nPeak Gate Akımları\nI_source_pk = min(10A, ΔV / (R_OH_EFF + Rg_on + R_G_int))\n            = min(10A, 20 / (0.7 + 22 + 6))\n            = min(10A, 20/28.7)\n            = 0.70 A\n\nI_sink_pk   = min(10A, ΔV / (R_OL + Rg_off + R_G_int))\n            = min(10A, 20 / (0.3 + 10 + 6))\n            = min(10A, 20/16.3)\n            = 1.23 A\n\n\nSürücü İç Güç Tüketimi (Termal Limit Kontrolü)\nP_Q  (quiescent) = 5mA × 20V                          = 100 mW\nP_SW (switching) = 0.5 × 0.0428 × 20V × 20kHz × 26nC  ≈ 0.22 mW\nP_DR (toplam)    ≈ 100 mW\n\n0.0428 = R_OH_EFF/(R_OH_EFF+Rg_on+R_G_int) + R_OL/(R_OL+Rg_off+R_G_int)\n       = 0.7/(0.7+22+6)        + 0.3/(0.3+10+6)\n       = 0.7/28.7              + 0.3/16.3\n       = 0.0244                + 0.0184\n       = 0.0428\n\nP_Rg_on  = (22/28.7) × 0.5 × 26nC × 20V × 20kHz ≈ 4.0 mW\n1/8W direnç \nRg_on = 22 Ω, Rg_off = 10 Ω \nP_Rg_off = (10/16.3) × 0.5 × 26nC × 20V × 20kHz ≈ 3.2 mW"
		(exclude_from_sim no)
		(at 13.97 15.24 0)
		(size 148.59 142.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left top)
		)
		(uuid "65c348f1-7520-4454-b178-6b025aa8a67e")
	)
	(text_box "AIN Pin kullanımı, MCU tarafında APWM filtreden geçirilir ve ADC'ye verilir.\nDaha kolay gibi, bu yöntemi tercih edeceğim, hesap zinciri ->\n1. dereceden basit\n\nfc << 400 kHz (PWM dalgalanması kalmasın) → en fazla ~40 kHz\nfc >> sinyal BW (sıcaklık yavaş, ~10-100 Hz yeterli)\nSweet spot: fc ≈ 1-10 kHz\n\nRfilt = 10 kΩ\nCfilt = 10 nF\nfc = 1/(2π × 10k × 10n) ≈ 1.6 kHz\n"
		(exclude_from_sim no)
		(at 13.97 158.75 0)
		(size 148.59 36.83)
		(margins 0.9525 0.9525 0.9525 0.9525)
