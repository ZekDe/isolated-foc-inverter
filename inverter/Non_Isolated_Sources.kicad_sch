	(text "C = 2P / (ΔV × Vbus × 2πf) -> %10 ripple(31V) 60Hz, 310V"
		(exclude_from_sim no)
		(at 53.34 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2a433028-e646-4ee9-a2c0-02c7d17a84fa")
	)
	(text "600mA"
		(exclude_from_sim no)
		(at 116.84 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "37ab1d77-ea5e-4e10-a1f1-f5b55206ea76")
	)
	(text "E = ½ × C × V² = ½ × 1000µF × 310² = 48J (şarj süresince direnç üzerinde)\nτ = R × C = 33 × 1000µF = 33ms\nBurası biraz daha incelenecek"
		(exclude_from_sim no)
		(at 60.96 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c36737d5-f9ee-4e79-948b-f3e545a9d80a")
	)
	(text "R = Vbus / I_hedef_max = 310 / 10A = 31Ω → 33Ω standart değer"
		(exclude_from_sim no)
		(at 55.88 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f598d457-96a6-43b6-902b-402551e148b1")
	)
	(text_box "Çıkış bobini: \nIsat > 1.5A\n330uH\nFPI1006-331K -> bu bobin uygun\n\nExternal Bias Resistor - 1mA akıtmalı\nR5(datasheet) = (V_OUT - V_D2 - V_BP) / I_target\n   = (15V - 0.7V - 5.2V) / 1 mA\n   = 9.1V / 1 mA\n   = 9.1 kΩ\nP_R5 = I² × R = (1 mA)² × 10 kΩ = 10 mW(SMD 0603 (1/10W))\n\nÇıkıştaki 4.7K gerekli durumda hesabı şu şekilde\nR4 ≤ V_OUT / 3 mA = 15V / 3 mA = 5 kΩ → standart 4.7 kΩ (3.2 mA çeker)"
		(exclude_from_sim no)
		(at 12.7 12.7 0)
		(size 87.63 33.02)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "abeecf62-f015-485a-8b24-6f02c88dc033")
	)
